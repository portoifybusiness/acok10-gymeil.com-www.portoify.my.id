# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MIDTRANS_SERVER_KEY: Midtrans payment gateway server key.
# Use 'SB-Mid-server-...' for Sandbox environment, or 'Mid-server-...' for Production mode.
MIDTRANS_SERVER_KEY=""

# DATABASE CONFIGURATION (MySQL):
# Set these connection details to sync and store all SaaS data directly inside your MySQL database.
# MySQL is the primary database. If connection details are omitted, the application runs on secure in-memory sandbox storage for safe sandbox testing.
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""

# GMAIL SMTP / NODEMAILER CONFIGURATION:
# Set MAIL_SMTP to "true" to send real emails via Google SMTP. If false or omitted, emails are printed inside the Node command line/terminal.
MAIL_SMTP="false"
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="465"
MAIL_USER="your-email@gmail.com"
MAIL_PASS="your-google-app-password"
MAIL_FROM_NAME="Portoify Helpdesk"


